{
    "index_patterns": [
        "maas-config-mission*"
    ],
    "settings": {
        "index": {
            "number_of_shards": 1,
            "number_of_replicas": 1
        }
    },
    "mappings": {
        "properties": {
            "display_name": {
                "type": "keyword",
                "description": "Human-readable display name of the mission"
            },
            "short_name": {
                "type": "keyword",
                "description": "Short name of the mission"
            },
            "key": {
                "type": "keyword",
                "description": "Unique key of the mission configuration entry"
            }
        },
        "_meta": {}
    }
}
