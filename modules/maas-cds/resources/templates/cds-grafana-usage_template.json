{
    "aliases": {
        "cds-grafana-usage": {}
    },
    "index_patterns": [
        "cds-grafana-usage-*"
    ],
    "settings": {
        "index": {
            "number_of_shards": 3,
            "number_of_replicas": 1
        }
    },
    "mappings": {
        "properties": {
            "access_date": {
                "type": "date",
                "format": "date_time",
                "locale": "utc",
                "description": "Date and time the Grafana dashboard was accessed"
            },
            "user": {
                "type": "keyword",
                "description": "User who accessed the Grafana dashboard"
            },
            "interface_name": {
                "type": "keyword",
                "description": "Name of the interface associated with the access"
            },
            "dashboard_title": {
                "type": "keyword",
                "description": "Title of the accessed Grafana dashboard"
            },
            "dashboard_uid": {
                "type": "keyword",
                "description": "Unique identifier of the accessed Grafana dashboard"
            }
        },
        "_meta": {
            "partition_field": "access_date",
            "partition_format": "%Y-%m"
        }
    }
}
