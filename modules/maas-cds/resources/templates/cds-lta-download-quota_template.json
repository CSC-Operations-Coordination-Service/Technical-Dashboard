{
    "aliases": {
        "cds-lta-download-quota": {}
    },
    "index_patterns": [
        "cds-lta-download-quota-*"
    ],
    "settings": {
        "index": {
            "number_of_shards": 3,
            "number_of_replicas": 1
        }
    },
    "mappings": {
        "properties": {
            "timestamp": {
                "type": "date",
                "format": "date_time",
                "locale": "utc",
                "description": "Timestamp of the download quota record"
            },
            "service_name": {
                "type": "keyword",
                "description": "Name of the LTA service the quota applies to"
            },
            "daily_download_quota": {
                "type": "long",
                "description": "Daily download quota for the service"
            }
        },
        "_meta": {
            "partition_field": "timestamp",
            "partition_format": "conf"
        }
    }
}
